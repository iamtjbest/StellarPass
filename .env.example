# ============================================================
# StellarPass MVP Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ---- Application ----
NODE_ENV=development
PORT=3001

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:3001

# ---- Stellar Blockchain (Soroban) ----
# Testnet configuration for MVP
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
NEXT_PUBLIC_STELLAR_CONTRACT_ID=C... # The ID of the deployed Soroban ticketing contract

# NEVER COMMIT SECRET KEYS. 
# Wallet abstractions and local CLI environments manage identities securely.
